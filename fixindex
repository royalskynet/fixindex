#!/usr/bin/env bash
# fixindex — feather-level adr-tools clone for FIX-INDEX system
# Usage: fixindex {find|grep|show|new|re-index|supersede|help} ...

set -euo pipefail

# Defaults look in the current working directory. Override with env vars
# (FIXINDEX_DIR / FIXINDEX_INDEX) to point at your own runbook checkout.
# 若未設定 → 從 ~/.zshenv 單一源自動讀取（worker 不必自己 export）。
# eval 而非 sed 抽值：BSD sed 不吃 \+，且 zshenv 的值含 $HOME 需要展開。
if [[ -z "${FIXINDEX_DIR:-}" && -f "$HOME/.zshenv" ]]; then
  eval "$(grep '^export FIXINDEX_DIR=' "$HOME/.zshenv" | head -1 || true)"
fi
if [[ -z "${FIXINDEX_INDEX:-}" && -f "$HOME/.zshenv" ]]; then
  eval "$(grep '^export FIXINDEX_INDEX=' "$HOME/.zshenv" | head -1 || true)"
fi
FIXDIR="${FIXINDEX_DIR:-$PWD/fixes}"
INDEX_FILE="${FIXINDEX_INDEX:-$PWD/FIX-INDEX.md}"
RG="${RG:-rg}"
FIXDIR_IS_DEFAULT=$([[ -n "${FIXINDEX_DIR:-}" ]] && echo 0 || echo 1)

die() { echo "fixindex: $*" >&2; exit 1; }

# ===== sync 層（0171：fixindex-git-autosync 復原）=====
# 目的：寫入命令「先 pull、結尾 commit+push」，寫入即落盤；push 失敗 Fail Loud。
# GIT_ROOT 用 git rev-parse --show-toplevel 動態解析（0171 §1），非寫死。
# 逃生門沿用 0171 命名：--no-sync flag（main 剝除）／FIXINDEX_NO_SYNC=1。
_parse_git_root() { git -C "$FIXDIR" rev-parse --show-toplevel 2>/dev/null || true; }
_has_upstream() {  # $1=GIT_ROOT；有 upstream → 0
  git -C "$1" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1
}
_sync_disabled() { [[ "${FIXINDEX_NO_SYNC:-}" == "1" ]] && return 0; return 1; }

# 寫入前 pull-first（dirty tree 是常態 → autostash）。pull 失敗 → die，不在過時基礎寫入。
sync_pull() {
  _sync_disabled && return 0
  local gr; gr=$(_parse_git_root)
  [[ -n "$gr" ]] || return 0          # 非 git repo → no-op
  _has_upstream "$gr" || return 0     # 無 upstream（feature 分支）→ 靜默跳過
  if ! git -C "$gr" pull --rebase --autostash >/dev/null 2>&1; then
    die "sync_pull: git pull 失敗，不在過時基礎上寫入 — 手動 'git -C $gr pull --rebase --autostash' 解決後重試，或 FIXINDEX_NO_SYNC=1 跳過"
  fi
}

# 唯讀命令的 soft pull：pull 失敗只印警告續跑（可離線），不 die。
sync_pull_soft() {
  _sync_disabled && return 0
  local gr; gr=$(_parse_git_root)
  [[ -n "$gr" ]] || return 0
  _has_upstream "$gr" || return 0
  if ! git -C "$gr" pull --rebase --autostash >/dev/null 2>&1; then
    echo "fixindex: warning — 唯讀 sync pull 失敗，續跑（可能非最新）" >&2
  fi
}

# 結尾：add -A → commit（帶 Co-Authored-By）→ push；無變動 → 靜默。
# push 失敗 → die（Fail Loud，不靜默吃錯）。無 upstream → 只 commit 不 push。
sync_push() {
  _sync_disabled && return 0
  local gr; gr=$(_parse_git_root)
  [[ -n "$gr" ]] || { echo "(no git repo, skip sync_push)"; return 0; }
  git -C "$gr" add -A
  if git -C "$gr" diff --cached --quiet; then
    echo "(no changes to commit)"
    return 0
  fi
  local cmsg
  cmsg="fixindex: autosync"
  git -C "$gr" commit -m "$cmsg" \
    -m "Co-Authored-By: Claude <noreply@anthropic.com>" \
    -m "Co-Authored-By: Happy <noreply@anthropic.com>" >/dev/null 2>&1 \
    || die "sync_push: git commit 失敗（Fail Loud）"
  if ! _has_upstream "$gr"; then
    echo "sync_push: committed（無 upstream，未 push）"
    return 0
  fi
  if ! git -C "$gr" push >/dev/null 2>&1; then
    die "sync_push: git push 失敗（Fail Loud）— 檢查 remote/網路後重試，或 FIXINDEX_NO_SYNC=1 跳過"
  fi
  echo "sync_push: pushed"
}


slugify() {
  local input="$1"
  local result
  result=$(echo "$input" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g;s/--*/-/g;s/^-//;s/-$//')
  if [[ -z "$result" ]]; then
    die "slug normalized to empty string. provide ASCII slug, or file will be unfindable (got: $input)"
  fi
  if [[ "$result" != "$input" ]]; then
    echo "fixindex: slug normalized: $input -> $result" >&2
  fi
  echo "$result"
}

with_lock() {
  local lockdir="$FIXDIR/.fixindex.lock"
  # 用整數重試次數計時，不要用 bc 產浮點 —— bash 的 (( )) 不吃小數，
  # 逾時判斷會每輪報 syntax error 而永遠不成立，變成無限等待。
  local tries=0 max_tries=100   # 100 × 0.1s = 10s
  while ! mkdir "$lockdir" 2>/dev/null; do
    if (( tries >= max_tries )); then
      die "another fixindex write is in progress (lock timeout after 10s). If no other fixindex is running, remove the stale lock: rmdir '$lockdir'"
    fi
    sleep 0.1
    tries=$((tries + 1))
  done
  # Execute in subshell so trap is scoped properly
  (
    trap 'rmdir "$lockdir" 2>/dev/null' EXIT INT TERM
    "$@"
  )
}

[[ -d "$FIXDIR" ]] || die "fixes dir missing: $FIXDIR"

# The cwd-relative default is convenient for a quick look but dangerous for
# writes: run a write command from the wrong directory and the entry lands in
# a second, silent runbook that `find` will never search from anywhere else.
# Warn (don't block) so scripted use keeps working.
warn_if_default_dir() {
  [[ "$FIXDIR_IS_DEFAULT" == 1 ]] || return 0
  cat >&2 <<EOF
fixindex: WARNING — FIXINDEX_DIR is not set, writing to the current directory:
    $FIXDIR
If that is not your runbook, this creates a second one that no other shell
will ever search. Set it once and forget it:
    export FIXINDEX_DIR="\$HOME/notes/runbook/fixes"
    export FIXINDEX_INDEX="\$HOME/notes/runbook/FIX-INDEX.md"
EOF
}

cmd_help() {
  cat <<'EOF'
fixindex — symptom→fix lookup for personal bug runbook

Commands:
  fixindex find <keyword>       BM25 + contextual blurb 語意排序（fxsearch）
  fixindex insights <topic>     find 限 type: insight（設計決策/可轉移洞見）；plan 起點按主題提取
  fixindex insights             無參數：列出全部 insight 條目
  fixindex grep <keyword>       full-text ripgrep across fix files
  fixindex show <id>            cat fixes/NNNN-*.md
  fixindex list                 list all fix files with title
  fixindex new <slug>           scaffold next-numbered fix file
  fixindex doctor [--fix]       diagnose and repair corrupted frontmatter
  fixindex re-index             regenerate FIX-INDEX.md directory table
  fixindex supersede <old> <new>  mark old superseded by new
  fixindex fi                 一行 pipe 記 defect/經驗（自動 dedup→append→建新→commit）
                               `printf 'SYMPTOM: …\\nFIX: …' | fixindex fi`（自由文字也行）
  fixindex fi <domain>        舊介面：指定 domain 直接 append（--title/--push/--new）
  fixindex auto               等同 `fixindex fi`（無參數，保留別名）
  fixindex help                 this message

What belongs in an entry:
  Write one after you FIX A DEFECT — not when a phase, task or session ends.
  Symptom before narrative: if you cannot write a Symptom someone would grep
  for, it is a status report, not an entry. Keep Verify a rerunnable command.
  See fixes/.template.md for the full do-not-write list.

Agent keyword:
  A bare `fi` from the user means "record what this conversation just
  produced, now" — the catch-up for a wrap-up that missed one. Agents should
  act on it immediately rather than asking what to write. See
  docs/agent-integration.md A.1.

Doctor:
  Checks for: (1) wrapped frontmatter (memory-node schema), (2) filename/id mismatch,
  (3) duplicate ids, (4) stub entries (empty/TODO titles), (5) filenames with spaces.
  Auto-repairs (1) and (2) with --fix; others are manual. See `fixindex doctor --help`.

Env:
  FIXINDEX_DIR    override fixes/ dir (default: ./fixes)
  FIXINDEX_INDEX  override FIX-INDEX.md path (default: ./FIX-INDEX.md)
  RG              ripgrep binary (default: rg)
  FIXINDEX_NO_SYNC=1  停用自動同步（寫入命令不 pull/push；亦可用 --no-sync flag）

Sync: 寫入命令（new/re-index/supersede/doctor/fi）寫入前 git pull、結尾 commit+push（寫入即落盤，push 失敗 Fail Loud）；唯讀命令 soft-pull 失敗僅警告續跑。逃生門：--no-sync 或 FIXINDEX_NO_SYNC=1。
EOF
}

# Resolve "0007" or "7" → fixes/0007-*.md
resolve_id() {
  local id="$1"
  printf -v id "%04d" "$((10#$id))"
  local f
  f=$(find "$FIXDIR" -maxdepth 1 -name "${id}-*.md" | head -1)
  [[ -n "$f" ]] || die "no fix with id $id"
  echo "$f"
}

cmd_show() {
  [[ $# -ge 1 ]] || die "usage: fixindex show <id>"
  cat "$(resolve_id "$1")"
}

cmd_list() {
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    local base id slug title
    base=$(basename "$f" .md)
    id="${base%%-*}"
    slug="${base#*-}"
    title=$(awk '/^title:/ {sub(/^title:[[:space:]]*/,""); print; exit}' "$f")
    printf "%s  %-32s  %s\n" "$id" "$slug" "$title"
  done
}

cmd_find() {
  [[ $# -ge 1 ]] || die "usage: fixindex find <keyword> [--json] [--all] [--limit N]"
  local self="${BASH_SOURCE[0]}"
  [[ -L "$self" ]] && self="$(readlink "$self")"
  local eng="${self%/*}/fxsearch.py"
  if [[ -f "$eng" ]] && command -v python3 >/dev/null 2>&1; then
    FIXINDEX_DIR="$FIXDIR" python3 "$eng" "$@" && return 0
    echo "[fixindex] fxsearch unavailable, falling back to literal grep" >&2
  fi
  _cmd_find_literal "$@"
}

_cmd_find_literal() {
  [[ $# -ge 1 ]] || die "usage: fixindex find <keyword>"
  local kw="$1"
  # Hit 1: frontmatter symptoms array entries
  echo "## symptoms match:"
  $RG -i --no-heading --line-number -F "$kw" "$FIXDIR"/[0-9]*.md 2>/dev/null \
    | awk -F: -v kw="$kw" '
      BEGIN { IGNORECASE=1 }
      {
        f=$1; ln=$2; rest=substr($0, length($1)+length($2)+3)
        # only show lines that look like symptoms entries or section headers
        if (rest ~ /^[[:space:]]*-[[:space:]]/ || rest ~ /^##[[:space:]]*§/) {
          n=split(f, a, "/"); base=a[n]; sub(/\.md$/,"",base)
          printf "  %-30s  L%-4s  %s\n", base, ln, rest
        }
      }' | head -40
  echo ""
  echo "(use \`fixindex grep '$kw'\` for full-text search)"
}

cmd_insights() {
  if [[ $# -eq 0 ]]; then
    # 無參數：列出全部 insight 條目（id + title）
    local f found=false
    for f in "$FIXDIR"/[0-9]*.md; do
      [[ -e "$f" ]] || continue
      grep -q '^type:[[:space:]]*insight' "$f" || continue
      found=true
      local base title
      base=$(basename "$f" .md)
      title=$(grep -m1 '^title:' "$f" | sed 's/^title:[[:space:]]*//; s/^"//; s/"$//')
      printf "  %-40s  %s\n" "$base" "$title"
    done
    $found || echo "(no insight entries yet — create one: fixindex new <slug> --type insight)"
    return 0
  fi
  cmd_find "$@" --type insight
}

cmd_grep() {
  [[ $# -ge 1 ]] || die "usage: fixindex grep <keyword>"
  $RG -i --heading --line-number -F "$1" "$FIXDIR"/[0-9]*.md
}

next_id() {
  local max=0 base id
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f")
    id="${base%%-*}"
    (( 10#$id > max )) && max=$((10#$id))
  done
  printf "%04d" "$((max+1))"
}

cmd_new() {
  [[ $# -ge 1 ]] || die "usage: fixindex new <slug> [--type defect|insight]"
  local input="" etype="defect"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)
        [[ $# -ge 2 ]] || die "usage: --type <defect|insight>"
        etype="$2"; shift 2
        ;;
      -h|--help) cmd_help; exit 0 ;;
      -*) die "slug must not start with '-' (got: $1)" ;;
      *)
        [[ -n "$input" ]] && die "usage: fixindex new <slug> [--type defect|insight]"
        input="$1"; shift
        ;;
    esac
  done
  [[ -n "$input" ]] || die "usage: fixindex new <slug> [--type defect|insight]"
  if [[ "$etype" != "defect" && "$etype" != "insight" ]]; then
    die "invalid --type '$etype' (must be defect or insight)"
  fi

  local slug
  slug=$(slugify "$input")
  # 剝掉開頭的數字編號前綴（如 "0417-foo" → "foo"），避免新檔變成 0418-0417-foo.md
  slug=$(echo "$slug" | sed -E 's/^[0-9]+-//')
  if [[ -z "$slug" ]]; then
    die "slug collapsed to empty after stripping numeric prefix (got: $input)"
  fi

  with_lock _cmd_new_write "$slug" "$etype"
}

_cmd_new_write() {
  local slug="$1" etype="${2:-defect}" id newfile
  id=$(next_id)
  newfile="$FIXDIR/${id}-${slug}.md"

  # Double-check no collision with same id (different slug)
  for existing in "$FIXDIR/${id}-"*.md; do
    [[ -e "$existing" ]] && die "id collision: $id already used by $(basename "$existing")"
  done

  if [[ "$etype" == "insight" ]]; then
    cat > "$newfile" <<EOF
---
id: $id
slug: $slug
type: insight
title: TODO
tags: []
symptoms: []
status: active
supersedes: []
related: []
---
# ${id} ${slug}

## §1 TODO 標題
**Context:** TODO
**Insight:** TODO
**Implication:** TODO
**Revisit-when:** TODO
EOF
  else
    cat > "$newfile" <<EOF
---
id: $id
slug: $slug
title: TODO
tags: []
symptoms: []
status: active
supersedes: []
related: []
---
# ${id} ${slug}

## §1 TODO 標題
**Symptom:** \`error msg\`
**Root cause:** TODO
**Fix:** TODO
**Verify:** TODO
EOF
  fi
  echo "$newfile"
  cmd_re_index
}

cmd_re_index() {
  # Lightweight check: warn if wrapped frontmatter detected
  # (don't block re-index, just alert)
  local wrapped_check=""
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    if _is_wrapped_frontmatter "$f"; then
      wrapped_check+=$'  '"$(basename "$f")"$'\n'
    fi
  done
  if [[ -n "$wrapped_check" ]]; then
    {
      echo "fixindex: WARNING — wrapped frontmatter detected in:"
      echo "$wrapped_check"
      echo "Run \`fixindex doctor --fix\` to repair"
    } >&2
  fi

  local tmp tbl
  tmp=$(mktemp)
  tbl=$(mktemp)
  local todo_list=""
  {
    echo "| ID | Slug | Title | Tags |"
    echo "|----|------|-------|------|"
    for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
      [[ -e "$f" ]] || continue
      local base id slug title tags status
      base=$(basename "$f" .md)
      id="${base%%-*}"
      slug="${base#*-}"
      title=$(awk '/^title:/ {sub(/^title:[[:space:]]*/,""); gsub(/^"/,""); gsub(/"$/,""); print; exit}' "$f")
      tags=$(awk '/^tags:/ {sub(/^tags:[[:space:]]*/,""); gsub(/[\[\]]/,""); print; exit}' "$f")
      status=$(awk '/^status:/ {sub(/^status:[[:space:]]*/,""); print; exit}' "$f")
      [[ "$status" == "superseded" ]] && id="~~$id~~"

      # Check if title is empty or exactly "TODO"
      if [[ -z "$title" ]] || [[ "$title" == "TODO" ]]; then
        todo_list+=$'\n'"    $id  $slug"
      fi

      printf "| %s | %s | %s | %s |\n" "$id" "$slug" "${title:-TODO}" "${tags:-}"
    done
  } > "$tbl"

  awk -v tbl="$tbl" '
    BEGIN { in_block=0 }
    /<!-- fixindex:table:start -->/ {
      print; while ((getline line < tbl) > 0) print line; close(tbl); in_block=1; next
    }
    /<!-- fixindex:table:end -->/ { print; in_block=0; next }
    !in_block { print }
  ' "$INDEX_FILE" > "$tmp"
  mv "$tmp" "$INDEX_FILE"
  rm -f "$tbl"
  echo "re-indexed: $INDEX_FILE"

  # Warn about unfilled scaffolds if any
  if [[ -n "$todo_list" ]]; then
    {
      echo "fixindex: WARNING — $(echo "$todo_list" | grep -c .) entries still have a TODO title (unfilled scaffolds):"
      echo "$todo_list"
      echo "Fill in \`title:\` / \`tags:\` / \`symptoms:\` or they will never be found by \`fixindex find\`."
    } >&2
  fi
}

# Find best matching fix file for a domain keyword (GRADED match, refuse-to-guess).
# Grades: ① slug exactly equals kw; ② slug starts with "<kw>-"; ③ substring only (weak).
# Only ①② are conclusive. ③ (or a tie among ③) is ambiguous → return empty so the
# caller creates a fresh entry rather than polluting an existing file. (B1: was
# "largest ID wins on substring" → wrongly picked 0394 over 0001 for 'hermes'.)
find_domain_file() {
  local kw="$1" best_g1="" best_g2=""
  # keyword → slug form for exact/prefix comparison (case-insensitive)
  local kslug
  kslug=$(printf '%s' "$kw" | tr '[:upper:]' '[:lower:]')
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    local base id slug slug_lower
    base=$(basename "$f" .md)
    id="${base%%-*}"
    slug="${base#*-}"
    slug_lower=$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')
    # fi（defect 路徑）不 append 進 insight 檔
    grep -q '^type:[[:space:]]*insight' "$f" && continue
    if [[ "$slug_lower" == "$kslug" ]]; then
      best_g1="$f"
    elif [[ "$slug_lower" == "$kslug-"* ]]; then
      best_g2="$f"
    fi
    # ③ substring 不在此計分——避免模糊誤配
  done
  # ①直接用；否則 ②直接用；只剩 ③ → 拒猜
  if [[ -n "$best_g1" ]]; then echo "$best_g1"; return; fi
  if [[ -n "$best_g2" ]]; then echo "$best_g2"; return; fi
  echo ""
}

# Count existing sections (§N) in a fix file
count_sections() {
  local n
  n=$(grep -c '^## §[0-9]' "$1" 2>/dev/null) || n=0
  echo "$n"
}

# Maximum numeric ## §N in file (0 if none). Use for the next append id —
# unlike count_sections, correct even when sections aren't contiguous (§10-13).
max_section() {
  local m
  m=$(grep -o '^## §[0-9][0-9]*' "$1" 2>/dev/null | grep -o '[0-9][0-9]*$' | sort -n | tail -1)
  echo "${m:-0}"
}

# Extract symptom lines from a **Symptom:** body block (stdin → stdout, one per line).
# Handles both "**Symptom:** text on same line" and continuation lines after it,
# stopping at the next **...:** field marker or end of body. Blank-line separated.
_extract_symptoms() {
  awk '
    /^\*\*Symptom:/ {
      rest=$0; sub(/^\*\*Symptom:\*\*[[:space:]]*/, "", rest)
      if (rest != "") print rest
      in_sym=1; buf=""; next
    }
    /^\*\*[A-Za-z ]+:/ {
      if (in_sym && buf != "") print buf
      in_sym=0; buf=""; next
    }
    in_sym {
      s=$0; gsub(/^[[:space:]]*/, "", s); gsub(/[[:space:]]*$/, "", s)
      if (s == "") { if (buf != "") { print buf; buf="" }; next }
      buf = (buf == "" ? s : buf " " s)
    }
    END { if (in_sym && buf != "") print buf }
  '
}

# Turn a line-per-symptom stream into a flow-style frontmatter list [a, b]
to_flow_list() {
  local out="" s
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    # strip double quotes & brackets so the flow list stays valid for fxmeta
    s=${s//\"/}
    s=${s//[[]/}
    s=${s//]/}
    out="${out:+$out, }$s"
  done
  echo "[$out]"
}

# Ensure body carries a `## §` heading. If none present, wrap it under §1.
# $1 = target file (to count existing sections), body on stdin → rebuilt body on stdout.
_ensure_section() {
  local file="$1" body
  body=$(cat)
  if ! grep -q '^## §[0-9]' <<<"$body"; then
    local n
    n=$(count_sections "$file")
    printf '## §%d 記錄\n\n%s\n' "$((n + 1))" "$body"
  else
    printf '%s\n' "$body"
  fi
}

# fi — record one defect/experience from stdin. 零參數＝一行 pipe（新主入口）。
#   eclipse `fixindex fi`（無參數）＝ fxauto 全自動：自由文字容錯、dedup/supersede、
#     無重複時 domain append §N（find_domain_file 分級匹配）或建新檔 → re-index → commit。
#   保留舊介面 `fixindex fi <domain> [--title/--tags/--push/--new]`（指定 domain 直接 append）。
cmd_fi() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    _cmd_fi_help
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    _cmd_fi_auto
    return 0
  fi
  # Legacy: fi <domain>
  local domain="$1"
  # Disallow flags as the domain argument.
  if [[ "$domain" == -* ]]; then
    die "domain must not start with '-' (got: $domain)"
  fi
  shift
  local title="" tags="" do_push=true force_new=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --tags) tags="$2"; shift 2 ;;
      --push) shift ;;   # 已預設開啟，保留為 no-op 相容（逃生門用 --no-sync / FIXINDEX_NO_SYNC=1）
      --new)  force_new=true; shift ;;
      *) shift ;;
    esac
  done
  local body
  body=$(cat)
  [[ -n "$body" ]] || die "no body provided on stdin"
  sync_pull
  with_lock _cmd_fi_write "$domain" "$title" "$tags" "$do_push" "$force_new" "$body"
}

# 零參數 fi / auto 共用：全自動管線（fxauto.py --commit）
_cmd_fi_auto() {
  local self="${BASH_SOURCE[0]}"
  [[ -L "$self" ]] && self="$(readlink "$self")"
  local fxauto="${self%/*}/fxauto.py"
  [[ -f "$fxauto" ]] || die "fxauto.py not found next to fixindex: $fxauto"
  FIXINDEX_DIR="$FIXDIR" python3 "$fxauto" --commit
}

# fixindex fi --help — ≤8 行 cheat sheet（首行即 canonical one-liner）
_cmd_fi_help() {
  cat <<'EOF'
fixindex fi — 一行 pipe 記 defect/經驗（自動 dedup→domain append→建新→re-index→commit）
  自由文字或 KEY 行皆可，例如：
  printf 'SYMPTOM: …\nROOT: …\nFIX: …\nVERIFY: …' | fixindex fi
  或 echo '一句話描述症狀' | fixindex fi
舊介面（指定 domain 直接 append）: fixindex fi <domain> [--title T] [--push] [--new]
誤配/誤寫還原: git checkout -- fixes/NNNN-*.md  （append 前有 .fi-undo- 快照）
EOF
}

_cmd_fi_write() {
  local domain="$1" title="$2" tags="$3" do_push="$4" force_new="$5" body="$6"

  local target
  target=$(find_domain_file "$domain")

  if [[ -n "$target" && "$force_new" != "true" ]]; then
    # Auto‑match protection: compute a crude similarity based on keyword presence in title
    local target_title
    target_title=$(awk '/^title:/ {sub(/^title:[[:space:]]*/,""); print; exit}' "$target")
    local similarity
    if echo "$target_title" | grep -iq "$domain"; then
      similarity="high"
    else
      similarity="low"
    fi
    echo "fi auto‑match: will append to ${target##*/} (title: $target_title) – similarity: $similarity"
    if [[ "$similarity" == "low" ]]; then
      echo "⚠️  Domain appears unrelated – consider using --new to force a new entry"
    fi

    local next_n
        next_n=$(($(max_section "$target") + 1))

        # B3: undo 快照（寫入前保留原檔，供誤配還原）
        local undo_backup
        undo_backup="$(dirname "$target")/.fi-undo-$(basename "$target").$$"
        cp "$target" "$undo_backup" 2>/dev/null || true

        # B2: append 永不改寫目標檔 title —— --title 只當 §N 標題用

        # Re-number section header
        local section_body symptom_list
        section_body=$(printf '%s\n' "$body" | sed -E 's/^## §[0-9]+/## §'"${next_n}"'/')
        # If body has no § heading, wrap it under §N so find can index it.
        if ! grep -q '^## §' <<<"$section_body"; then
          local sec_head="${title:-記錄}"
          section_body=$(printf '## §%d %s\n\n%s\n' "$next_n" "$sec_head" "$body")
        fi

        echo "" >> "$target"
        printf '%s\n' "$section_body" >> "$target"

        # Merge new symptoms into the target's frontmatter so `find` picks them up.
        symptom_json=$(printf '%s\n' "$body" | _extract_symptoms | python3 -c "import json,sys; items=[l.strip() for l in sys.stdin if l.strip()]; print(json.dumps(items, ensure_ascii=False))")
        if [[ "$symptom_json" != "[]" ]]; then
          TARGET="$target" SYM_JSON="$symptom_json" python3 <<'PYEOF'
import json, os, sys, re
from pathlib import Path

target = Path(os.environ['TARGET'])
new_syms = json.loads(os.environ['SYM_JSON'])
if not new_syms:
    sys.exit(0)

lines = target.read_text(encoding='utf-8').splitlines(keepends=True)
dash = [i for i, l in enumerate(lines) if l.strip() == '---']
if len(dash) < 2:
    sys.exit(0)

fm = lines[dash[0]:dash[1] + 1]
syms_start = syms_end = None
for i, l in enumerate(fm):
    s = l.strip()
    if s.startswith('symptoms:'):
        syms_start = i
    elif syms_start is not None and s and not s.startswith('- '):
        syms_end = i
        break
if syms_end is None:
    syms_end = len(fm)

existing = []
for i in range(syms_start or 0, syms_end or len(fm)):
    l = fm[i]; s = l.strip()
    if s.startswith('symptoms:'):
        val = s[len('symptoms:'):].strip()
        if val.startswith('[') and val.endswith(']'):
            inner = val[1:-1].strip()
            if inner:
                try:
                    existing.extend(str(x) for x in json.loads('[' + inner + ']'))
                except json.JSONDecodeError:
                    for it in inner.split(', '):
                        existing.append(it.strip())
    elif s.startswith('- '):
        item = s[2:].strip()
        if item.startswith('"') and item.endswith('"'):
            try:
                item = json.loads(item)
            except json.JSONDecodeError:
                pass
        existing.append(str(item))

all_items = []
seen = set()
for it in existing + new_syms:
    it_str = str(it)
    if it_str not in seen:
        seen.add(it_str)
        all_items.append(it_str)

block = 'symptoms:\n'
for it in all_items:
    block += f'  - {json.dumps(it, ensure_ascii=False)}\n'
new_fm = (fm[:syms_start] if syms_start is not None else []) + [block] + (fm[syms_end:] if syms_end is not None else fm)
result = lines[:dash[0]] + new_fm + lines[dash[1] + 1:]
target.write_text(''.join(result), encoding='utf-8')
PYEOF
        fi

        echo "appended: ${target##*/} (§${next_n})"
        echo "  誤以為誤配/誤寫 → 還原：git checkout -- ${target##*/}  (undo 快照 ${undo_backup##*/})"
  else
    local slug_name
    slug_name=$(slugify "$domain")

    local id newfile
    id=$(next_id)
    newfile="$FIXDIR/${id}-${slug_name}.md"

    # Double-check no collision with same id
    for existing in "$FIXDIR/${id}-"*.md; do
      [[ -e "$existing" ]] && die "id collision: $id already used by $(basename "$existing")"
    done

    # Write frontmatter + template
    cat > "$newfile" <<INNEREOF
---
id: $id
slug: $slug_name
title: "${title:-TODO}"
tags: [${tags:-}]
symptoms: []
status: active
supersedes: []
related: []
---
# ${id} ${slug_name}

INNEREOF

    # Fill symptoms from body (so find 建完即命中), then append body with §1.
    local symptom_list
    symptom_json=$(printf '%s\n' "$body" | _extract_symptoms | python3 -c "import json,sys; items=[l.strip() for l in sys.stdin if l.strip()]; print(json.dumps(items, ensure_ascii=False))")
    if [[ "$symptom_json" != "[]" ]]; then
      TARGET="$newfile" SYM_JSON="$symptom_json" python3 <<'PYEOF'
import json, os, re
from pathlib import Path

target = Path(os.environ['TARGET'])
syms = json.loads(os.environ['SYM_JSON'])
if not syms:
    raise SystemExit(0)
text = target.read_text(encoding='utf-8')
block_lines = ['symptoms:']
for it in syms:
    block_lines.append(f'  - {json.dumps(it, ensure_ascii=False)}')
block = '\n'.join(block_lines)
text = re.sub(r'(?m)^symptoms:.*(?:\n  - .*)*', lambda m: block, text)
target.write_text(text, encoding='utf-8')
PYEOF
    fi
    # If title still TODO and body has a Symptom line, seed title from it.
    if [[ -z "${title:-}" ]]; then
      local first_sym
      first_sym=$(printf '%s\n' "$body" | _extract_symptoms | head -1)
      if [[ -n "$first_sym" ]]; then
        TITLE_SAFE=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1], ensure_ascii=False))" "$first_sym")
        sed -i '' "s|^title:.*|title: $TITLE_SAFE|" "$newfile"
      fi
    fi

    # Append body with §1 re-numbering; wrap in a section if body lacks one.
    local section_body sec_head
    section_body=$(printf '%s\n' "$body" | sed -E 's/^## §[0-9]+/## §1/')
    if ! grep -q '^## §' <<<"$section_body"; then
      sec_head="${title:-記錄}"
      section_body=$(printf '## §1 %s\n\n%s\n' "$sec_head" "$body")
    fi
    printf '%s\n' "$section_body" >> "$newfile"

    echo "created: ${newfile##*/}"
  fi

  cmd_re_index
  sync_push
}
# Extract frontmatter block (lines between --- markers, excluding the markers)
_get_frontmatter() {
  local f="$1"
  sed -n '2,/^---$/p' "$f" | sed '$d'
}

# Check if frontmatter is wrapped in memory-node schema (has metadata: or name: "")
_is_wrapped_frontmatter() {
  local f="$1"
  local fm
  fm=$(_get_frontmatter "$f")
  echo "$fm" | grep -q -E "^(metadata:|name:[[:space:]]*\"\")" && return 0 || return 1
}

# Extract id from frontmatter (handles both "id: 334" and "id: 0334")
_extract_fm_id() {
  local f="$1"
  awk '/^id:/ {sub(/^id:[[:space:]]*/,""); gsub(/"/, ""); print; exit}' "$f"
}

# Extract title from frontmatter (top-level only, not in metadata:)
_extract_fm_title() {
  local f="$1"
  _get_frontmatter "$f" | awk '/^title:/ {sub(/^title:[[:space:]]*/,""); gsub(/^"/,""); gsub(/"$/,""); print; exit}'
}

# Detect vestigial tags (auto/shadow) in frontmatter tags — flow and block forms
_has_vestigial_tag() {
  local f="$1"
  local fm
  fm=$(_get_frontmatter "$f")
  # block form: - auto / - shadow (精確整行，避免 auto-decomposer 誤判)
  if printf '%s\n' "$fm" | grep -qE '^[[:space:]]*-[[:space:]]*(auto|shadow)[[:space:]]*$'; then
    return 0
  fi
  # flow form: tags: [a, auto, b] — python 精確拆元素比對（子字串會誤報 auto-goal 等）
  if printf '%s\n' "$fm" | python3 -c '
import sys, re
fm = sys.stdin.read()
m = re.search(r"^tags:[ \t]*\[(.*?)\]", fm, re.M)
if not m:
    sys.exit(1)
items = [x.strip().strip(chr(34) + chr(39)) for x in m.group(1).split(",") if x.strip()]
sys.exit(0 if ("auto" in items or "shadow" in items) else 1)
'; then
    return 0
  fi
  return 1
}

# Repair wrapped frontmatter: flatten memory-node schema back to fixindex schema
_repair_wrapped_fm() {
  local f="$1" id="$2"
  local backup="$FIXDIR/../.doctor-backup-$(basename "$f")"
  cp "$f" "$backup" || return 1

  # Use python to flatten YAML since bash YAML parsing is painful.
  # We must preserve the body (everything after the second ---).
  python3 - "$f" "$id" <<'PYTHON_EOF'
import sys
import re

filepath = sys.argv[1]
expected_id = sys.argv[2]

with open(filepath, 'r') as file:
    lines = file.read().split('\n')

# Find frontmatter boundaries
fm_start = None
fm_end = None
for i, line in enumerate(lines):
    if line.strip() == '---':
        if fm_start is None:
            fm_start = i
        elif fm_end is None:
            fm_end = i
            break

if fm_start is None or fm_end is None:
    sys.exit(1)

fm_lines = lines[fm_start + 1 : fm_end]
body_lines = lines[fm_end + 1:]

# Parse frontmatter: collect fields (including multi-line arrays)
fields = {}
in_metadata = False
metadata_base_indent = None
current_key = None
current_lines = []

for line in fm_lines:
    # Check for metadata: marker
    if line.startswith('metadata:'):
        if current_key:
            fields[current_key] = current_lines
        in_metadata = True
        metadata_base_indent = len(line) - len(line.lstrip())
        current_key = None
        current_lines = []
        continue

    # Check for end of metadata block (non-indented content)
    if in_metadata and line and not line[0].isspace():
        if current_key:
            fields[current_key] = current_lines
        in_metadata = False
        current_key = None
        current_lines = []

    # Skip name field and non-key lines
    if line.startswith('name:') or line.strip().startswith('#'):
        continue

    # Parse top-level or metadata field
    if in_metadata:
        line_indent = len(line) - len(line.lstrip()) if line.strip() else 0
        # Check if this is a key line (at metadata level)
        if line.strip() and line_indent == metadata_base_indent + 2:
            match = re.match(r'^(\s+)(\w+):\s*(.*)', line)
            if match:
                # Skip harness-specific fields
                key = match.group(2)
                if key not in ['node_type', 'originSessionId']:
                    if current_key:
                        fields[current_key] = current_lines
                    current_key = key
                    val = match.group(3).strip()
                    current_lines = [val] if val else []
        elif line.strip():
            # Array item or sub-field: append to current_lines
            if current_key:
                current_lines.append(line.rstrip())
    else:
        # Top-level field
        if ':' in line:
            match = re.match(r'^(\w+):\s*(.*)', line)
            if match:
                key = match.group(1)
                val = match.group(2).strip()
                if current_key:
                    fields[current_key] = current_lines
                current_key = key
                current_lines = [val] if val else []

# Save last field
if current_key:
    fields[current_key] = current_lines

# Clean up and normalize array fields
cleaned_fields = {}
for k, v in fields.items():
    if isinstance(v, list):
        val_lines = [line.strip() for line in v if line.strip()]
    else:
        val_lines = [str(v).strip()] if v else []

    if not val_lines:
        continue

    # Check if this looks like a YAML array (lines starting with -)
    if k in ['tags', 'symptoms', 'related', 'supersedes']:
        # 一律 block list（與 fxmeta 一致）；flow 輸入也拆成 block
        items = []
        for ln in val_lines:
            s = ln.strip()
            if s.startswith('-'):
                items.append(s.lstrip('- ').strip().strip('"\''))
            elif s:
                items.extend(x.strip().strip('"\'') for x in s.split(',') if x.strip())
        cleaned_fields[k] = items
    elif val_lines:
        # Single-value field
        cleaned_fields[k] = val_lines[0] if len(val_lines) == 1 else '\n'.join(val_lines)

# Normalize id
if 'id' in cleaned_fields:
    try:
        cleaned_fields['id'] = f"{int(cleaned_fields['id']):04d}"
    except ValueError:
        cleaned_fields['id'] = expected_id
else:
    cleaned_fields['id'] = expected_id

# Ensure all standard fields exist
standard_fields = ['id', 'slug', 'type', 'title', 'tags', 'symptoms', 'status', 'supersedes', 'related']
final_fields = {}
for field in standard_fields:
    # `type` 特例：有才寫、缺不回填，避免 defect 檔修復後多出 type
    if field == 'type':
        if field in cleaned_fields and cleaned_fields[field]:
            final_fields[field] = cleaned_fields[field]
        continue
    if field in cleaned_fields and cleaned_fields[field]:
        final_fields[field] = cleaned_fields[field]
    else:
        if field == 'id':
            final_fields[field] = expected_id
        elif field == 'status':
            final_fields[field] = 'active'
        else:
            final_fields[field] = '[]' if field in ['tags', 'symptoms', 'related', 'supersedes'] else 'TODO'

# Reconstruct frontmatter
new_fm = ['---']
for field in standard_fields:
    if field in final_fields:
        v = final_fields[field]
        if isinstance(v, list):
            # block list（與 fxmeta 一致
            new_fm.append(f"{field}:")
            for item in v:
                new_fm.append(f"  - {item}")
        else:
            new_fm.append(f"{field}: {v}")
new_fm.append('---')

# Write file
with open(filepath, 'w') as f:
    f.write('\n'.join(new_fm + body_lines))

print(f'repaired: {filepath}')
PYTHON_EOF
  return $?
}

# Main doctor command: diagnose and optionally repair frontmatter issues

# 四位零填充比較用。必須用 10# 強制十進位 —— bash 的 printf %d 走 strtol base 0，
# "0011" 會被當八進位解成 9，"0008" 直接是非法八進位而報錯並吐出半截輸出。
# 這個 bug 曾讓 doctor 把 255 個正常檔全部誤報成 id mismatch。
_normalize_id() {
  local raw="${1:-}"
  raw="${raw//[^0-9]/}"
  [[ -n "$raw" ]] || { echo ""; return; }
  printf "%04d" "$((10#$raw))"
}

cmd_doctor() {
  local fix=false
  case "${1:-}" in
    --fix) fix=true ;;
    --help|-h) _cmd_doctor_help; return 0 ;;
    "") fix=false ;;
    *) die "doctor: unknown option $1 (try 'fixindex doctor --help')" ;;
  esac

  if [[ "$fix" == "true" ]]; then
    with_lock _cmd_doctor_fix
  else
    _cmd_doctor_check
  fi
}

_cmd_doctor_help() {
  cat <<'EOF'
fixindex doctor — diagnose and repair corrupted frontmatter

Usage:
  fixindex doctor        diagnose only (read-only)
  fixindex doctor --fix  auto-repair categories 1-2
  fixindex doctor --help this message

Checks 5 categories:
  1. Wrapped frontmatter (memory-node schema with metadata: block)
  2. ID mismatch (filename vs frontmatter id:)
  3. Duplicate IDs (multiple files with same 4-digit prefix)
  4. Stub entries (empty or TODO title)
  5. Filenames with spaces

Auto-repairs with --fix:
  Categories 1-2 are auto-repaired. Categories 3-5 are reported only
  (require manual judgment to avoid breaking cross-references).

Exit codes:
  0 = all clear or repair successful
  1 = issues found (or repair encountered errors)
EOF
}

_cmd_doctor_check() {
  # Diagnose mode: read-only reporting
  local wrapped_list=() mismatch_list=() stub_list=() space_list=() missing_list=() trunc_list=() vestigial_list=()
  local files_checked=0

  # Scan all fix files
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    files_checked=$((files_checked+1))

    local base fname id
    base=$(basename "$f" .md)
    fname=$(basename "$f")
    id="${base%%-*}"

    # Check 1: wrapped frontmatter
    local is_wrapped=false
    if _is_wrapped_frontmatter "$f"; then
      wrapped_list+=("$fname")
      is_wrapped=true
    fi

    # Check 2: id mismatch (only if NOT wrapped)
    # Wrapped files will be fixed when unwrapped, so don't report separately
    if [[ "$is_wrapped" == "false" ]]; then
      local fm_id
      fm_id=$(_normalize_id "$(_extract_fm_id "$f")")
      if [[ "$fm_id" != "$id" ]]; then
        mismatch_list+=("$fname (id: $fm_id, expect $id)")
      fi
    fi

    # Check 4: stub entries (empty or TODO title)
    # Note: wrapped files may show this, but it's secondary to the wrapping issue
    local title
    title=$(_extract_fm_title "$f")
    if [[ -z "$title" || "$title" == "TODO" ]]; then
      stub_list+=("$fname")
    fi

    # Check 5: filenames with spaces
    if [[ "$fname" =~ " " ]]; then
      space_list+=("$fname")
    fi

    # Check 6: missing sections (non-stub entries without any ## §N headings)
    if [[ -n "$title" && "$title" != "TODO" ]]; then
      local nsections
      nsections=$(count_sections "$f")
      if [[ "$nsections" -eq 0 ]]; then
        missing_list+=("$fname")
      fi
    fi

    # Check 7: 截斷 title（≥78 字且結尾不是 …/。/）—— 報告用，不自動修
    if [[ -n "$title" && "$title" != "TODO" && ${#title} -ge 78 ]]; then
      local tlast="${title: -1}"
      if [[ "$tlast" != "…" && "$tlast" != "。" && "$tlast" != ")" ]]; then
        trunc_list+=("$fname (${#title} chars: ${title:0:40}…)")
      fi
    fi

    # Check 8: vestigial tag（tags 含 auto/shadow）—— 可自動修
    if _has_vestigial_tag "$f"; then
      vestigial_list+=("$fname")
    fi
  done

  # Check 3: duplicate IDs
  local dup_ids=""
  dup_ids=$(ls "$FIXDIR"/*.md 2>/dev/null | xargs -n1 basename | grep -oE '^[0-9]{4}' | sort | uniq -d)
  local dup_list=()
  if [[ -n "$dup_ids" ]]; then
    while IFS= read -r dup_id; do
      for f in "$FIXDIR"/${dup_id}-*.md; do
        [[ -e "$f" ]] && dup_list+=("$(basename "$f")")
      done
    done <<<"$dup_ids"
  fi

  # Report issues
  local has_issues=false

  if [[ ${#wrapped_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "wrapped frontmatter (${#wrapped_list[@]} files):"
    printf '  %s\n' "${wrapped_list[@]}"
  fi

  if [[ ${#mismatch_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "id mismatch (${#mismatch_list[@]} files):"
    printf '  %s\n' "${mismatch_list[@]}"
  fi

  if [[ ${#dup_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "duplicate ids (${#dup_list[@]} files):"
    printf '  %s\n' "${dup_list[@]}"
  fi

  if [[ ${#stub_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "stub entries (${#stub_list[@]} files):"
    printf '  %s\n' "${stub_list[@]}"
  fi

  if [[ ${#space_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "filenames with spaces (${#space_list[@]} files):"
    printf '  %s\n' "${space_list[@]}"
  fi

  if [[ ${#missing_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "missing sections (${#missing_list[@]} files):"
    printf '  %s\n' "${missing_list[@]}"
  fi

  if [[ ${#trunc_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "truncated titles (${#trunc_list[@]} files, report only):"
    printf '  %s\n' "${trunc_list[@]}"
  fi

  if [[ ${#vestigial_list[@]} -gt 0 ]]; then
    has_issues=true
    echo "vestigial tags (${#vestigial_list[@]} files, auto-fixable):"
    printf '  %s\n' "${vestigial_list[@]}"
  fi

  # Summary
  if [[ "$has_issues" == "false" ]]; then
    echo "doctor: all clear ($files_checked files checked)"
    return 0
  else
    local total_issues=$((${#wrapped_list[@]} + ${#mismatch_list[@]} + ${#dup_list[@]} + ${#stub_list[@]} + ${#space_list[@]} + ${#missing_list[@]} + ${#trunc_list[@]} + ${#vestigial_list[@]}))
    echo ""
    echo "doctor: 8 checks, $total_issues issues found (run \`fixindex doctor --fix\` to auto-repair categories 1-2,8)"
    return 1
  fi
}

_cmd_doctor_fix() {
  # Repair mode: auto-fix categories 1-2
  local fixed_wrapped=0 fixed_mismatch=0 fixed_tags=0 repair_errors=0

  # Scan all fix files
  for f in "$FIXDIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue

    local base id
    base=$(basename "$f" .md)
    id="${base%%-*}"

    # Repair 1: wrapped frontmatter (takes priority)
    local is_wrapped=false
    if _is_wrapped_frontmatter "$f"; then
      if _repair_wrapped_fm "$f" "$id"; then
        fixed_wrapped=$((fixed_wrapped+1))
        is_wrapped=true
      else
        repair_errors=$((repair_errors+1))
      fi
    fi

    # Repair 2: id mismatch (only if NOT wrapped)
    if [[ "$is_wrapped" == "false" ]]; then
      local fm_id
      fm_id=$(_normalize_id "$(_extract_fm_id "$f")")
      if [[ "$fm_id" != "$id" ]]; then
        sed -i '' "s/^id:[[:space:]]*[0-9]*/id: $id/" "$f" && fixed_mismatch=$((fixed_mismatch+1)) || repair_errors=$((repair_errors+1))
      fi
    fi

    # Repair 8: vestigial tags (auto/shadow) — 經 fxmeta strip_tags，保留 body 與非 ORDER 欄位
    if _has_vestigial_tag "$f"; then
      local strip_out
      strip_out=$(python3 "$(dirname "${BASH_SOURCE[0]}")/fxmeta.py" strip_tags "$f" "auto,shadow" --no-dry 2>&1)
      if [[ $? -eq 0 ]]; then
        fixed_tags=$((fixed_tags+1))
      else
        echo "doctor: strip_tags failed on $f: $strip_out" >&2
        repair_errors=$((repair_errors+1))
      fi
    fi
  done

  # Report results
  if [[ $repair_errors -eq 0 ]]; then
    echo "doctor: repaired $fixed_wrapped wrapped frontmatter, $fixed_mismatch id mismatches, $fixed_tags vestigial tags"
    # Re-run check to confirm
    _cmd_doctor_check
  else
    echo "doctor: repair completed with $repair_errors errors" >&2
    return 1
  fi
}

cmd_supersede() {
  [[ $# -eq 2 ]] || die "usage: fixindex supersede <old_id> <new_id>"
  local old_f new_f
  old_f=$(resolve_id "$1")
  new_f=$(resolve_id "$2")
  # mark old as superseded (only touch frontmatter status line)
  sed -i.bak -E "s/^status:[[:space:]]*.*/status: superseded/" "$old_f"
  rm -f "${old_f}.bak"
  # append supersedes ref to new file frontmatter if not present
  awk -v old_id="$(basename "$old_f" | cut -d- -f1)" '
    /^supersedes:/ && !done { sub(/\[\]/, "[" old_id "]"); done=1 }
    { print }
  ' "$new_f" > "${new_f}.tmp" && mv "${new_f}.tmp" "$new_f"
  cmd_re_index
}

cmd_auto() {
  # Capture ONE experience from stdin (KEY: value lines: SYMPTOM/ROOT/FIX/VERIFY)
  # or from --symptom/--fix/--tags flags (non-interactive one-shot).
  # One-shot pipeline: dedup → supersede → re-index (via fxauto.py --commit).
  # 自動捕捉「重大開發/除錯結束記一筆」: agent 呼叫此指令, 不記個案、只記可索引經驗。
  local self="${BASH_SOURCE[0]}"
  [[ -L "$self" ]] && self="$(readlink "$self")"
  local fxauto="${self%/*}/fxauto.py"
  if [[ ! -f "$fxauto" ]]; then
    die "fxauto.py not found next to fixindex: $fxauto"
  fi
  local title="" symptom="" fix="" tags="" has_title=0 has_symptom=0 has_fix=0 has_tags=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)   title="$2"; has_title=1; shift 2 ;;
      --symptom) symptom="$2"; has_symptom=1; shift 2 ;;
      --fix)     fix="$2"; has_fix=1; shift 2 ;;
      --tags)    tags="$2"; has_tags=1; shift 2 ;;
      --commit|--shadow) shift ;;
      -h|--help) cat <<'EOF'
fixindex auto — capture ONE experience from stdin/flags (dedup → supersede → index)

Usage:
  echo "<自由文字，或 KEY: value 行（SYMPTOM/ROOT/FIX/VERIFY/KEYPOINT/TAGS）>" | fixindex auto [--title T]
  fixindex auto --symptom "..." --fix "..." [--tags a,b] [--title T]

Flags:
  --title T   entry title (default: first SYMPTOM line or auto-derived)
  --symptom S non-interactive symptom
  --fix F     non-interactive fix/root
  --tags T    comma-separated tags
  --commit    run re-index + commit (default)
  --shadow    dry-run, no commit

Minimal valid stdin (KEY: value lines — at least one SYMPTOM, or a title):
  SYMPTOM: terminal 跑 pytest 崩
  FIX: 修 lifecycle_guard 第二崩點
EOF
        exit 0 ;;
      *) die "unknown auto option: $1 (try 'fixindex auto --help'); note: stdin 請用 'KEY: value' 行格式（SYMPTOM/ROOT/FIX/VERIFY/KEYPOINT/TAGS 皆可），例如：echo 'SYMPTOM: foo' | fixindex auto" ;;
    esac
  done
  # 一鍵直落：--symptom/--fix/--tags 齊（title 可用首 symptom）即不讀 stdin
  local rxargs=()
  [[ $has_title -eq 1 ]] && rxargs+=(--title "$title")
  [[ $has_symptom -eq 1 ]] && rxargs+=(--symptom "$symptom")
  [[ $has_fix -eq 1 ]] && rxargs+=(--fix "$fix")
  [[ $has_tags -eq 1 ]] && rxargs+=(--tags "$tags")
  # D2: flags 齊時不再提前 return 跳過 stdin —— 一律透傳 stdin 給 fxauto.py
  # （KEY 行補欄位、非 KEY 行進 §5 詳情）。tty 下 stdin 無料 → body 空 → flags-only。
  local body=""
  if [[ ! -t 0 ]]; then
    body=$(cat)
  fi
  if [[ -n "$body" ]]; then
    FIXINDEX_DIR="$FIXDIR" python3 "$fxauto" ${rxargs[@]+"${rxargs[@]}"} --commit <<EOF
$body
EOF
  else
    FIXINDEX_DIR="$FIXDIR" python3 "$fxauto" ${rxargs[@]+"${rxargs[@]}"} --commit
  fi
}

cmd_status_lint() {
  # R3-4: status: superseded 但 supersedes 為空 → 報錯（0452 形態）
  local dir="${FIXINDEX_DIR:-${FIXDIR:-$HOME/.claude/projects/-Users-51mini/memory/fixes}}"
  [[ -d "$dir" ]] || { echo "fixindex status lint: FIXINDEX_DIR 不存在: $dir"; return 1; }
  local f status supersedes superseded_by bad=0
  for f in "$dir"/[0-9][0-9][0-9][0-9]-*.md "$dir"/[0-9][0-9][0-9][0-9].md; do
    [[ -f "$f" ]] || continue
    status=$(awk '/^status:/ {sub(/^status:[[:space:]]*/,""); print; exit}' "$f")
    supersedes=$(awk '/^supersedes:/ {sub(/^supersedes:[[:space:]]*/,""); print; exit}' "$f")
    superseded_by=$(awk '/^superseded_by:/ {sub(/^superseded_by:[[:space:]]*/,""); print; exit}' "$f")
    if [[ "$status" == "superseded" ]]; then
      # 被取代的 stub 用 superseded_by 表達「被誰取代」——合法；兩欄皆空才是異常
      if { [[ -z "$supersedes" || "$supersedes" == "[]" || "$supersedes" == "''" ]] \
           && [[ -z "$superseded_by" ]]; }; then
        echo "LINT FAIL: $(basename "$f") status=superseded 但 supersedes 與 superseded_by 皆空"
        bad=1
      fi
    fi
  done
  if [[ $bad -eq 1 ]]; then
    echo "fixindex status lint: FAIL — 上述條目需補 supersedes 或改回非 superseded"
    return 1
  fi
  echo "fixindex status lint: PASS — 所有 superseded 條目皆有 supersedes"
  return 0
}

# status 主入口：fxstatus.py（三段：index 時效 / git 同步 / lint）；缺檔 fallback 舊 lint
_cmd_status_fxstatus() {
  local self="${BASH_SOURCE[0]}"
  [[ -L "$self" ]] && self="$(readlink "$self")"
  local fxstatus="${self%/*}/fxstatus.py"
  if [[ -f "$fxstatus" ]]; then
    FIXINDEX_DIR="$FIXDIR" FIXINDEX_INDEX="$INDEX_FILE" python3 "$fxstatus" "$@"
    return $?
  fi
  cmd_status_lint "$@"
}

main() {
  # 逃生門：--no-sync 在 arg list 任意位置剝除 → FIXINDEX_NO_SYNC=1
  local args=() a
  for a in "$@"; do
    if [[ "$a" == "--no-sync" ]]; then
      FIXINDEX_NO_SYNC=1
    else
      args+=("$a")
    fi
  done
  set -- "${args[@]}"
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    find)      sync_pull_soft; cmd_find "$@" ;;
    insights)  sync_pull_soft; cmd_insights "$@" ;;
    grep)      sync_pull_soft; cmd_grep "$@" ;;
    show)      sync_pull_soft; cmd_show "$@" ;;
    list)      sync_pull_soft; cmd_list ;;
    new)       warn_if_default_dir; sync_pull; cmd_new "$@"; sync_push ;;
    doctor)    warn_if_default_dir; sync_pull; cmd_doctor "$@"; sync_push ;;
    status)    warn_if_default_dir; _cmd_status_fxstatus "$@" ;;
    re-index)  warn_if_default_dir; sync_pull; cmd_re_index; sync_push ;;
    supersede) warn_if_default_dir; sync_pull; cmd_supersede "$@"; sync_push ;;
    fi)        warn_if_default_dir; cmd_fi "$@" ;;
    auto)      warn_if_default_dir; cmd_auto "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command: $sub (try 'fixindex help')" ;;
  esac
}

main "$@"

